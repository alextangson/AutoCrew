{
  "name": "autocrew",
  "version": "0.1.0",
  "description": "AI content operations crew — automated research, writing, and publishing pipeline.",
  "type": "module",
  "license": "MIT",
  "author": "alextangson",
  "repository": {
    "type": "git",
    "url": "https://github.com/alextangson/AutoCrew.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "claude-code",
    "claude-code-plugin",
    "ai-agent",
    "content-ops",
    "automation"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.3.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.48"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"mcp/**/*.ts\" index.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
