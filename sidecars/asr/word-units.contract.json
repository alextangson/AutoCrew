    { "text": "今天聊聊 DeepSeek，它很强。", "units": ["今", "天", "聊", "聊", "DeepSeek", "它", "很", "强"] },
    { "text": "GPT-4 与 C++ 的差别", "units": ["GPT", "4", "与", "C", "的", "差", "别"] },
    { "text": "don't 说 I'm fine", "units": ["don't", "说", "I'm", "fine"] },
    { "text": "第2版，2026 年", "units": ["第", "2", "版", "2026", "年"] },
    { "text": "a_b_c 下划线不占词", "units": ["a", "b", "c", "下", "划", "线", "不", "占", "词"] },
    { "text": "全角数字１２３ 与 ①", "units": ["全", "角", "数", "字", "１", "２", "３", "与", "①"] },
    { "text": "。，！？——…… ", "units": [] },
    { "text": "", "units": [] },
    { "text": "把 deepsick 改回 DeepSeek", "units": ["把", "deepsick", "改", "回", "DeepSeek"] },
    { "text": "emoji 🎬 不进词", "units": ["emoji", "不", "进", "词"] }
  ]
